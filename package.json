{
  "name": "bloom",
  "version": "1.0.0",
  "private": true,
  "description": "Bloom \u2014 a calm, shared baby tracker for the whole family",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",

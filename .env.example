# Database (the application connects with the restricted role, not the owner)
DATABASE_URL=postgres://bloom_app:CHANGE_ME@127.0.0.1:5432/bloom

# Reminder worker: role with BYPASSRLS (system process only)
WORKER_DATABASE_URL=postgres://bloom_worker:CHANGE_ME@127.0.0.1:5432/bloom

# Used only by scripts/migrate.mjs; keep out of the runtime environment
DATABASE_ADMIN_URL=postgres://postgres@/bloom?host=/var/run/postgresql

APP_URL=http://localhost:3001
AUTH_SECRET=replace-with-32-bytes-of-random-hex

# Email (optional in development; required for verification + password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bloom <hello@example.com>

# Web push (generate with: npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Optional: path for uploaded photos. Defaults to ./uploads
UPLOAD_DIR=./uploads
